{
  "name": "github-issue-triage-dashboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "refresh-data": "npm run refresh-and-verify",
    "refresh-and-verify": "node scripts/refresh-and-verify.mjs",
    "build": "node scripts/build.mjs",
    "build-static": "node scripts/build-static.mjs",
    "test": "node --test tests/*.test.mjs",
    "browser-check": "node scripts/browser-check.mjs",
    "verify": "node scripts/verify.mjs",
    "verify-static": "node scripts/verify-static.mjs",
    "clean-install-check": "node scripts/clean-install-check.mjs",
    "security-check": "npm audit --audit-level=high",
    "serve": "node scripts/serve.mjs",
    "serve-static": "STATIC_ROOT=dist node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  }
}
